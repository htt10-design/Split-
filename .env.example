# Die beiden Personen (Name = Login-Name). Passwörter min. 8 Zeichen.
USER1_NAME=Ich
USER1_PASSWORD=bitte-aendern-1
USER2_NAME=Partnerin
USER2_PASSWORD=bitte-aendern-2

# Port im Container / lokal
PORT=3000

# Hinter einem Reverse-Proxy oder Cloudflare Tunnel auf 1 setzen
TRUST_PROXY=1

# Nur für docker-compose mit Cloudflare Tunnel (siehe README)
CLOUDFLARE_TUNNEL_TOKEN=

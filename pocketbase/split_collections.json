        "type": "autodate",
        "onCreate": true,
        "onUpdate": false,
        "hidden": false,
        "system": false
      },
      {
        "name": "updated",
        "type": "autodate",
        "onCreate": true,
        "onUpdate": true,
        "hidden": false,
        "system": false
      }
    ],
    "indexes": [
      "CREATE INDEX idx_split_expenses_open ON split_expenses (`group`, settlement)"
